<% limit = defined?(limit) ? limit : nil %>
<% resources = blog(:blog).articles %>
<% resources = limit ? resources.first(limit) : resources %>
<% resources.each do |resource| %>
  <% cs = resource.data %>
  <% tag = Array(cs.tags).first.to_s %>
  <a href="<%= resource.url %>" class="flex flex-col rounded-lg stroke-1 outline outline-1 outline-offset-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-900 outline-gray-300 flex-1 shadow-md hover:shadow-lg transition-shadow cursor-pointer overflow-hidden"
    data-filter-card
    data-type="<%= tag %>"
    data-region="<%= cs.region.to_s %>">
    <div class="overflow-hidden rounded-t-lg bg-white">
      <% gallery_image = cs.gallery&.first %>
      <% if gallery_image %>
        <%= image_tag(gallery_image.image, class: "w-full h-full aspect-[2/1] object-cover line-clamp-2", alt: (gallery_image.alt.present? ? gallery_image.alt : cs.title)) %>
      <% else %>
        <%= image_tag "/images/placeholder.jpg", class: "w-full h-full aspect-[2/1] object-cover line-clamp-2", alt: cs.title %>
      <% end %>
    </div>
    <div class="flex gap-2 flex-wrap overflow-hidden px-4 pt-3">
      <% if tag.present? %>
        <span class="text-sm bg-red-100 text-red-500 rounded px-2 py-1"><%= tag %></span>
      <% end %>
    </div>
    <div class="md:py-3 pb-4 pt-3 px-4">
      <p class="md:text-2xl text-xl font-bold text-black line-clamp-2 min-h-0 md:h-16 md:pb-16"><%= cs.title %></p>
    </div>
    <div class="mt-auto">
      <time class="par-sm text-gray-500 block px-4 pb-4"><%= resource.date.strftime('%d/%m/%Y') %></time>
      <div class="text-red-500 mt-auto flex items-center gap-2 md:pb-4 md:pl-4 px-4 pb-4">
        <span><%= t("blog.read") %></span>
        <%= icon "ri-arrow-right-line", class: "w-4 h-4 mt-1 block self-center shrink-0" %>
      </div>
    </div>
  </a>
<% end %>
