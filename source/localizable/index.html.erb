---
description:
pageClass: home
---
<section class="bg-gray-100">
    <div class="container relative pt-32 md:pt-56 pb-12 md:pb-24">
      <div class="md:w-1/2">
        <h1 class="h1 md:text-6xl md:text-nowrap"><%= t("index.hero.subheading") %></h1>
        <h3 class="h3 py-5 !font-light pt-5 pb-10"><%= t("index.hero.intro") %></h3>
        <div class="w-fit">
          <%= partial "partials/arrow-link-rounded", locals: { text: t("index.hero.cta"), url: "#{t(:path)}/first-steps" } %>
        </div>
        <img src="/images/index/index-hero.png" alt="" class="block md:hidden w-full mt-10 object-cover">
      </div>
      <div class="w-fit">
        <img src="/images/index/index-hero.png" alt="" class="hidden md:block absolute top-0 right-0 h-full object-cover">
      </div>
    </div>
  <% if alert_enabled? && homepage? %>
    <%= partial "/partials/alert-banner" %>
  <% end %>
</section>

<section>
  <div class="container md:pt-16 pt-10 space-y-10">
    <h2 class="h2"><%= t("index.installations.title") %></h2>
    <%= partial "partials/main_installations", locals: { classes: "py-10" } %>
    <%= partial "partials/arrow-link", locals: { text: t("index.installations.cta"), url: "#{t(:path)}/installations" } %>
  </div>
</section>

<section>
  <div class="container md:pt-16 pt-10">
    <div class="flex flex-col md:flex-row md:justify-between md:items-start gap-4">
      <h2 class="h2">
        <%= t("index.subhero.title") %>
      </h2>
      <div class="hidden md:block">
        <%= partial "partials/arrow-link-rounded", locals: { text: t("index.subhero.cta"), url: "#{t(:path)}/features" } %>
      </div>
    </div>
    <p class="par-md md:py-6 pt-5 max-w-prose text-black">
      <%= t("index.subhero.subtitle") %>
    </p>
  </div>
  <div class="container flex flex-col gap-5 md:gap-4 pt-12 md:pt-10 pb-12">
    <% data.index.features.each_with_index do |feat, i| %>
      <div class="flex flex-col md:flex-row items-center gap-8 md:gap-12 bg-gray-50 border-r-2 border-gray-100 <%= 'md:flex-row-reverse border-l-2 border-gray-100' if i.odd? %>">
        <!-- Image side -->
        <div class="w-full md:w-1/2 rounded-xl overflow-hidden">
          <img class="w-full h-auto object-cover" src="<%= feat.image %>" alt="<%= t("index.subhero.#{feat.id}.title") %>">
        </div>

        <!-- Text side -->
        <div class="w-full md:w-1/2 md:p-16">
          <h3 class="text-2xl md:text-3xl font-bold pb-6 pt-8">
            <%= t("index.subhero.#{feat.id}.title") %>
          </h3>
          <p class="text-lg text-gray-600 pb-8">
            <%= t("index.subhero.#{feat.id}.text") %>
          </p>
        </div>
      </div>
    <% end %>
    <div class="md:hidden block">
      <%= partial "partials/arrow-link-rounded", locals: { text: t("index.subhero.cta"), url: "#{t(:path)}/features" } %>
    </div>
  </div>
</section>

<section class="md:pb-16">
  <div class="container pt-10">
    <div class="flex flex-col md:flex-row md:justify-between md:items-start gap-4">
      <h2 class="h2">
        <%= t("index.use_cases.title") %>
      </h2>
      <div class="hidden md:block">
        <%= partial "partials/arrow-link-rounded", locals: { text: t("first-steps.section2.link"), url: "#{t(:path)}/features" } %>
      </div>
    </div>
    <p class="par-md md:py-6 pt-5 max-w-prose text-black">
      <%= t("index.use_cases.subtitle") %>
    </p>
  </div>
  <div class="container">
    <div class="flex flex-col md:flex-row items-stretch gap-5 pt-5 pb-5">
      <%= partial "/partials/case-study-cards", locals: { limit: 3 } %>
    </div>
  </div>
    <div class="md:hidden md:pb-0 pb-10">
      <%= partial "partials/arrow-link-rounded", locals: { text: t("first-steps.section2.link"), url: "#{t(:path)}/features" } %>
    </div>
  </div>
</section>

<section>
  <h2 class="h2 container md:py-16 py-5"><%= t("index.subhero.intro_html") %></h2>
  <div class="container py-4 flex flex-col md:flex-row justify-between items-stretch divide-y-2 md:divide-y-0 divide-gray-100">
    <% data.index.cards.each_with_index do |item, index| %>
      <div class="flex flex-col pb-8 md:py-0 md:pr-5 md:w-1/3">
        <div class="flex flex-row-reverse md:flex-col">
          <img src="<%= item.image %>" alt="" class="w-full h-full items-center">
        </div>
        <div class="<%= 'md:border-r-2 border-gray-100 md:pr-5' unless index == data.index.cards.length - 1 %> flex flex-col flex-1">
          <p class="par-sm uppercase font-bold md:pt-8 pt-5"><%= t("index.cards.#{item.title}") %></p>
          <p class="par-sm max-w-prose mt-4 mb-6"><%= t("index.cards.#{item.content}") %></p>
          <%= partial "partials/arrow-link", locals: { text: t("index.cards.#{item.link}"), url: url(item.url), classes: "text-red-500 mt-auto block", icon_name: "ri-external-link-line", icon_classes: "w-4 h-4" } %>
        </div>
      </div>
    <% end %>
  </div>
</section>

<section class="md:pb-6 md:pt-16 pb-5">
  <img src="/images/home-banner.jpg" alt="" class="banner object-cover">
</section>

<%= partial "/partials/testimonials" %>

<section class="md:pt-16 pt-10">
  <div class="relative h-[448px] md:h-[576px]">
    <img src="/images/home-footer-banner.jpg" alt="" class="absolute inset-0 w-full h-full object-cover">
    <div class="relative container h-full flex flex-col justify-end pb-8 md:pb-16">
      <div class="text-white">
        <h1 class="h2"><%= t("index.footer_banner.heading") %></h1>
        <p class="md:text-4xl text-2xl pt-8"><%= t("index.footer_banner.intro") %></p>
      </div>
    </div>
  </div>
</section>

<%= partial "/partials/cta-banner" %>
