<a href="<%= url %>" class="flex items-center space-x-1 par-md hover:underline <%= classes ||= 'underline' %>">
  <% if defined?(reverse) && reverse %>
    <%= icon(icon_name ||= "ri-arrow-left-line", { class: "#{icon_classes ||= 'md:w-4 md:h-4 w-4 h-4'} mt-1 block self-center shrink-0" }) %>
    <span class="pl-1 <%= span_classes ||= 'par-sm' %>"><%= text %></span>
  <% else %>
    <span class="pr-1 <%= span_classes ||= 'par-sm' %>"><%= text %></span>
    <%= icon(icon_name ||= "ri-arrow-right-line", { class: "#{icon_classes ||= 'md:w-4 md:h-4 w-4 h-4'} mt-1 block self-center shrink-0" }) %>
  <% end %>
</a>
