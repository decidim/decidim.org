<div class="grid grid-cols-2 md:grid-cols-5 gap-3 md:gap-x-5 items-center md:gap-y-5 <%= classes ||= '' %>">
  <% data_sort_by(data_select_home(data.installations), "priority").take(5).each_with_index do |logo, i| %>
    <a class="items-center justify-center inline-block p-2 md:p-6" href="<%= logo[1][:url] %>" target="_blank" rel="noopener noreferrer">
      <img class="object-contain w-40 h-28 md:w-56 md:h-44 md:py-4" src="<%= logo[1][:image] %>" alt="<%= logo[1][:name] %>">
    </a>
  <% end %>
</div>
