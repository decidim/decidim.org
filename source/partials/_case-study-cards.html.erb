<% limit = defined?(limit) ? limit : nil %>
<% resources = blog(:case_studies).articles %>
<% resources = limit ? resources.first(limit) : resources %>
<% resources.each do |resource| %>
  <% cs = resource.data %>
  <a href="<%= resource.url %>" class="flex flex-col rounded-lg outline outline-1 outline-offset-0 outline-gray-300 flex-1 shadow-md hover:shadow-lg transition-shadow cursor-pointer overflow-hidden"
    data-filter-card
    data-type="<%= cs.type.to_s %>"
    data-region="<%= cs.region.to_s %>">
    <div class="overflow-hidden rounded-t-lg bg-gray-300">
      <% gallery_image = cs.gallery&.first %>
      <% if gallery_image %>
        <img class="w-full h-full aspect-[2/1] object-cover" src="<%= gallery_image.image %>" alt="<%= gallery_image.alt.present? ? gallery_image.alt : cs.title %>">
      <% else %>
        <img class="w-full h-full aspect-[2/1] object-cover" src="/images/placeholder.jpg" alt="<%= cs.title %>">
      <% end %>
    </div>
    <div class="flex gap-2 flex-wrap md:px-6 px-3 pt-4">
      <% if cs.type.present? %>
        <span class="text-sm bg-red-100 text-red-500 rounded px-2 py-1"><%= cs.type %></span>
      <% end %>
      <% if cs.region.present? %>
        <span class="text-sm bg-red-100 text-red-500 rounded px-2 py-1"><%= cs.region %></span>
      <% end %>
    </div>
    <h5 class="h5 pt-4 md:px-6 px-3 line-clamp-2"><%= cs.title %></h5>
    <p class="par-md pt-4 text-gray-500 md:px-6 px-3 line-clamp-3"><%= cs.subtitle %></p>
    <div class="text-red-500 mt-auto md:pb-6 pb-4 flex items-center gap-2 md:pl-6 pl-3 pt-4">
      <span><%= t("case_studies.read") %></span>
      <%= icon "ri-arrow-right-line", class: "w-4 h-4 block self-center shrink-0" %>
    </div>
  </a>
<% end %>
