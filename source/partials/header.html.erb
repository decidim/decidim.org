<% if alert_enabled? && !homepage? %>
  <%= partial "/partials/alert-banner" %>
<% end %>
<header class="bg-transparent w-full min-h-[5rem] <%= 'absolute top-0 left-0 z-10 text-white filter-img-alt' if homepage? %>">
  <div class="container pt-6 md:pt-12 pb-4 flex flex-col md:flex-row justify-between items-center pointer-events-none <%= 'absolute md:relative' unless homepage? %>">
    <div class="w-full md:w-auto flex justify-between items-center pointer-events-auto">
      <a href="<%= t(:path) %>/">
        <img class="hidden md:block" src="/images/decidim-logo-claim.svg" alt="Decidim" />
        <img class="block md:hidden" src="/images/decidim-symbol.svg" alt="Decidim" />
      </a>
      <button class="md:hidden flex items-center space-x-3" data-toggle-header>
        <span class="par-sm"><%= t('nav.menu') %></span>
        <span class="hidden par-sm"><%= t('nav.close_menu') %></span>
        <div class="flex-none relative inline w-5 h-5">
          <%= icon "ri-menu-fill", class: "absolute w-5 h-4 mt-1 animate-fade-in" %>
          <%= icon "ri-close-line", class: "absolute w-5 h-4 mt-1 animate-fade-out" %>
        </div>
      </button>
    </div>
    <nav class="relative -translate-y-[200%] md:translate-y-0 transition mt-10 md:mt-0 w-full md:w-auto md:h-auto flex flex-col md:flex-row items-center gap-12 md:gap-8 pointer-events-auto">
      <div class="w-full md:w-auto flex flex-col md:flex-row items-start md:items-center md:gap-8 divide-y-4 md:divide-y-0 divide-gray-100 border-y-4 md:border-y-0 border-gray-100" data-accordion="header">

        <details class="group w-full md:w-auto md:relative">
          <summary class="flex items-center justify-between md:justify-start md:gap-2 py-4 md:py-0 md:px-2 cursor-pointer list-none group-open:font-bold group-open:bg-red-100 group-open:border-b-2 group-open:border-red-500 group-open:text-red-500">
            <span>Product</span>
            <span class="flex w-4 h-4 text-red-500">
              <svg class="w-4 h-4 absolute group-open:hidden no-toggle" fill="currentColor"><use xlink:href="/images/remixicon.symbol.svg#ri-arrow-down-s-line"></use></svg>
              <svg class="w-4 h-4 absolute hidden group-open:block no-toggle" fill="currentColor"><use xlink:href="/images/remixicon.symbol.svg#ri-arrow-up-s-line"></use></svg>
            </span>
          </summary>
          <nav class="text-red-500 md:absolute md:top-full md:left-0 md:bg-white md:shadow-lg md:min-w-[200px] md:py-2 space-y-3 md:space-y-0 pointer-events-none md:pointer-events-auto -translate-y-full md:translate-y-0 max-h-0 md:max-h-none opacity-0 md:opacity-100 transition-all md:px-4 group-open:border-b-2 group-open:border-red-500">
            <%= link_to t('nav.first-steps'), "#{t(:path)}/first-steps", class: "block md:py-2" %>
            <%= link_to t('nav.features'), "#{t(:path)}/features", class: "block md:py-2" %>
            <%= link_to t('nav.modules'), "#{t(:path)}/modules", class: "block md:py-2" %>
            <%= link_to t('nav.docs.title'), "#{t(:path)}/documentation", class: "block md:py-2" %>
          </nav>
        </details>

        <details class="group w-full md:w-auto md:relative">
          <summary class="flex items-center justify-between md:justify-start md:gap-2 py-4 md:py-0 md:px-2 cursor-pointer list-none group-open:font-bold group-open:bg-red-100 group-open:border-b-2 group-open:border-red-500 group-open:text-red-500">
            <span>In use</span>
            <span class="flex w-4 h-4 text-red-500">
              <svg class="w-4 h-4 absolute group-open:hidden no-toggle" fill="currentColor"><use xlink:href="/images/remixicon.symbol.svg#ri-arrow-down-s-line"></use></svg>
              <svg class="w-4 h-4 absolute hidden group-open:block no-toggle" fill="currentColor"><use xlink:href="/images/remixicon.symbol.svg#ri-arrow-up-s-line"></use></svg>
            </span>
          </summary>
          <nav class="text-red-500 md:absolute md:top-full md:left-0 md:bg-white md:shadow-lg md:min-w-[200px] md:py-2 space-y-3 md:space-y-0 pointer-events-none md:pointer-events-auto -translate-y-full md:translate-y-0 max-h-0 md:max-h-none opacity-0 md:opacity-100 transition-all md:px-4 group-open:border-b-2 group-open:border-red-500">
            <%= link_to t('nav.used_by'), "#{t(:path)}/usedby", class: "block md:py-2" %>
            <%= link_to t('nav.installations'), "#{t(:path)}/installations", class: "block md:py-2" %>
            <%= link_to t('nav.case-studies'), "#{t(:path)}/case-studies", class: "block md:py-2" %>
          </nav>
        </details>

        <details class="group w-full md:w-auto md:relative">
          <summary class="flex items-center justify-between md:justify-start md:gap-2 py-4 md:py-0 md:px-2 cursor-pointer list-none group-open:font-bold group-open:bg-red-100 group-open:border-b-2 group-open:border-red-500 group-open:text-red-500">
            <span>About us</span>
            <span class="flex w-4 h-4 text-red-500">
              <svg class="w-4 h-4 absolute group-open:hidden no-toggle" fill="currentColor"><use xlink:href="/images/remixicon.symbol.svg#ri-arrow-down-s-line"></use></svg>
              <svg class="w-4 h-4 absolute hidden group-open:block no-toggle" fill="currentColor"><use xlink:href="/images/remixicon.symbol.svg#ri-arrow-up-s-line"></use></svg>
            </span>
          </summary>
          <nav class="text-red-500 md:absolute md:top-full md:left-0 md:bg-white md:shadow-lg md:min-w-[200px] md:py-2 space-y-3 md:space-y-0 pointer-events-none md:pointer-events-auto -translate-y-full md:translate-y-0 max-h-0 md:max-h-none opacity-0 md:opacity-100 transition-all md:px-4 group-open:border-b-2 group-open:border-red-500">
            <%= link_to t('nav.association'), "#{t(:path)}/about", class: "block md:py-2" %>
            <%= link_to t('nav.team'), "#{t(:path)}/team", class: "block md:py-2" %>
            <%= link_to t('nav.book'), "#{t(:path)}/book", class: "block md:py-2" %>
            <%= link_to t('nav.supporters'), "#{t(:path)}/supporters", class: "block md:py-2" %>
            <%= link_to t('nav.contact'), "#{t(:path)}/contact", class: "block md:py-2" %>
          </nav>
        </details>

        <details class="group w-full md:w-auto md:relative">
          <summary class="flex items-center justify-between md:justify-start md:gap-2 py-4 md:py-0 md:px-2 cursor-pointer list-none group-open:font-bold group-open:bg-red-100 group-open:border-b-2 group-open:border-red-500 group-open:text-red-500">
            <span>Community</span>
            <span class="flex w-4 h-4 text-red-500">
              <svg class="w-4 h-4 absolute group-open:hidden no-toggle" fill="currentColor"><use xlink:href="/images/remixicon.symbol.svg#ri-arrow-down-s-line"></use></svg>
              <svg class="w-4 h-4 absolute hidden group-open:block no-toggle" fill="currentColor"><use xlink:href="/images/remixicon.symbol.svg#ri-arrow-up-s-line"></use></svg>
            </span>
          </summary>
          <nav class="text-red-500 md:absolute md:top-full md:left-0 md:bg-white md:shadow-lg md:min-w-[200px] md:py-2 space-y-3 md:space-y-0 pointer-events-none md:pointer-events-auto -translate-y-full md:translate-y-0 max-h-0 md:max-h-none opacity-0 md:opacity-100 transition-all md:px-4 group-open:border-b-2 group-open:border-red-500">
            <%= link_to "Metadecidim", "https://meta.decidim.org/en/", target: "_blank", rel: "noopener noreferrer", class: "block md:py-2" %>
            <%= link_to t('nav.partners'), "#{t(:path)}/partners", class: "block md:py-2" %>
          </nav>
        </details>

        <details class="group w-full md:w-auto md:relative">
          <summary class="flex items-center justify-between md:justify-start md:gap-2 py-4 md:py-0 md:px-2 cursor-pointer list-none group-open:font-bold group-open:bg-red-100 group-open:border-b-2 group-open:border-red-500 group-open:text-red-500">
            <span>News</span>
            <span class="flex w-4 h-4 text-red-500">
              <svg class="w-4 h-4 absolute group-open:hidden no-toggle" fill="currentColor"><use xlink:href="/images/remixicon.symbol.svg#ri-arrow-down-s-line"></use></svg>
              <svg class="w-4 h-4 absolute hidden group-open:block no-toggle" fill="currentColor"><use xlink:href="/images/remixicon.symbol.svg#ri-arrow-up-s-line"></use></svg>
            </span>
          </summary>
          <nav class="text-red-500 md:absolute md:top-full md:left-0 md:bg-white md:shadow-lg md:min-w-[200px] md:py-2 space-y-3 md:space-y-0 pointer-events-none md:pointer-events-auto -translate-y-full md:translate-y-0 max-h-0 md:max-h-none opacity-0 md:opacity-100 transition-all md:px-4 group-open:border-b-2 group-open:border-red-500">
            <%= link_to t('nav.blog'), "#{t(:path)}/blog", class: "block md:py-2" %>
          </nav>
        </details>
      </div>
      <%= link_to t('demo.button'), "https://try.decidim.org/", target: "_blank", rel: "noopener noreferrer", class: "button inline-block text-center py-4 w-full md:w-auto" %>
      <%= partial "/partials/language-selector" %>
    </nav>
  </div>
</header>
