<% limit = defined?(limit) ? limit : nil %>
<% resources = blog(:partners).articles.reverse %>
<% resources = limit ? resources.first(limit) : resources %>
<% resources.each do |resource| %>
  <% cs = resource.data %>
  <a href="<%= resource.url %>" class="flex flex-col md:p-4 p-3 rounded-lg outline outline-1 outline-offset-0 outline-gray-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-900 flex-1 shadow-md hover:shadow-lg transition-shadow cursor-pointer overflow-hidden"
    data-filter-card
    data-type="<%= Array(cs.type).join(" | ") %>"
    data-region="<%= cs.region.to_s %>">
    <div class="overflow-hidden rounded-t-lg bg-white">
      <% cs.gallery&.first %>
      <% if cs.image&.image %>
        <%= image_tag(cs.image.image, class: "w-full h-28 object-contain object-center md:py-8 py-8 px-5", alt: (cs.image.alt.nil? ? cs.name : cs.image.alt)) %>
      <% else %>
        <%= image_tag("/images/placeholder.jpg", class: "w-full h-28 object-contain object-center md:py-8 py-8 px-5", alt: cs.title) %>
      <% end %>
    </div>
    <div class="flex gap-2 flex-wrap md:pb-16 md:h-16 overflow-hidden">
      <% Array(cs.type).each do |type| %>
        <span class="text-sm bg-red-100 text-red-500 rounded px-2 py-1"><%= type %></span>
      <% end %>
      <% if cs.region.present? %>
        <span class="text-sm bg-red-100 text-red-500 rounded px-2 py-1"><%= cs.region %></span>
      <% end %>
    </div>
    <p class="md:py-3 pb-4 pt-3 md:text-2xl text-xl font-bold text-black"><%= cs.name %></p>
    <div class="text-red-500 mt-auto flex items-center gap-2">
      <span><%= t("partners.read") %></span>
      <%= icon "ri-arrow-right-line", class: "w-4 h-4 mt-1 block self-center shrink-0" %>
    </div>
  </a>
<% end %>
