<footer class="bg-black text-white par-xs">
  <div class="container py-4">
    <div class="flex items-baseline md:items-center mt-4 md:mt-8">
      <a class="w-3/4" href="<%= t(:path) %>/"><img src="/images/decidim-symbol-white.svg" alt="Decidim" /></a>
    </div>

    <div class="flex mt-6 md:mt-12">

      <%# "mobile menu footer" %>
      <div class="block md:hidden w-full divide-y divide-gray-500 cursor-pointer" data-accordion="footer">
        <details class="w-full group">
          <summary class="flex items-center justify-between space-x-4 py-2">
            <h3 class="font-bold"><%= t("footer.product") %></h3>
            <div class="flex-none w-5 h-5">
              <%= icon "ri-arrow-down-s-line", class: "w-5 h-5 group-open:hidden no-toggle" %>
              <%= icon "ri-arrow-up-s-line", class: "hidden group-open:block w-5 h-5 no-toggle" %>
            </div>
          </summary>
          <nav class="space-y-3 group-open:py-3 pointer-events-none -translate-y-full max-h-0 opacity-0 transition-all">
            <% data.links.product.each do |link| %>
              <%= link_to t(link.name, default: link.name), link.url, class: "block" %>
            <% end %>
          </nav>
        </details>

        <details class="w-full group">
          <summary class="flex items-center justify-between space-x-4 py-2">
            <h3 class="font-bold"><%= t("footer.in_use") %></h3>
            <div class="flex-none w-5 h-5">
              <%= icon "ri-arrow-down-s-line", class: "w-5 h-5 group-open:hidden no-toggle" %>
              <%= icon "ri-arrow-up-s-line", class: "hidden group-open:block w-5 h-5 no-toggle" %>
            </div>
          </summary>
          <nav class="space-y-3 group-open:py-3 pointer-events-none -translate-y-full max-h-0 opacity-0 transition-all">
            <% data.links.in_use.each do |link| %>
              <%= link_to t(link.name, default: link.name), link.url, class: "block" %>
            <% end %>
          </nav>
        </details>

        <details class="w-full group">
          <summary class="flex items-center justify-between space-x-4 py-2">
            <h3 class="font-bold"><%= t("footer.about_us") %></h3>
            <div class="flex-none w-5 h-5">
              <%= icon "ri-arrow-down-s-line", class: "w-5 h-5 group-open:hidden no-toggle" %>
              <%= icon "ri-arrow-up-s-line", class: "hidden group-open:block w-5 h-5 no-toggle" %>
            </div>
          </summary>
          <nav class="space-y-3 group-open:py-3 pointer-events-none -translate-y-full max-h-0 opacity-0 transition-all">
            <% data.links.about.each do |link| %>
              <%= link_to t(link.name, default: link.name), link.url, class: "block" %>
            <% end %>
          </nav>
        </details>

        <details class="w-full group">
          <summary class="flex items-center justify-between space-x-4 py-2">
            <h3 class="font-bold"><%= t("footer.community") %></h3>
            <div class="flex-none w-5 h-5">
              <%= icon "ri-arrow-down-s-line", class: "w-5 h-5 group-open:hidden no-toggle" %>
              <%= icon "ri-arrow-up-s-line", class: "hidden group-open:block w-5 h-5 no-toggle" %>
            </div>
          </summary>
          <nav class="space-y-3 group-open:py-3 pointer-events-none -translate-y-full max-h-0 opacity-0 transition-all">
            <% data.links.community.each do |link| %>
              <%= link_to t(link.name, default: link.name), link.url, class: "block" %>
            <% end %>
          </nav>
        </details>

        <details class="w-full group">
          <summary class="flex items-center justify-between space-x-4 py-2">
            <h3 class="font-bold"><%= t("footer.news") %></h3>
            <div class="flex-none w-5 h-5">
              <%= icon "ri-arrow-down-s-line", class: "w-5 h-5 group-open:hidden no-toggle" %>
              <%= icon "ri-arrow-up-s-line", class: "hidden group-open:block w-5 h-5 no-toggle" %>
            </div>
          </summary>
          <nav class="space-y-3 group-open:py-3 pointer-events-none -translate-y-full max-h-0 opacity-0 transition-all">
            <% data.links.news.each do |link| %>
              <%= link_to t(link.name, default: link.name), link.url, class: "block" %>
            <% end %>
          </nav>
        </details>

        <details class="w-full group">
          <summary class="flex items-center justify-between space-x-4 py-2">
            <h3 class="font-bold"><%= t("footer.legal") %></h3>
            <div class="flex-none w-5 h-5">
              <%= icon "ri-arrow-down-s-line", class: "w-5 h-5 group-open:hidden no-toggle" %>
              <%= icon "ri-arrow-up-s-line", class: "hidden group-open:block w-5 h-5 no-toggle" %>
            </div>
          </summary>
          <nav class="space-y-3 group-open:py-3 pointer-events-none -translate-y-full max-h-0 opacity-0 transition-all">
            <% data.links.legal.each do |link| %>
              <%= link_to t(link.name, default: link.name), link.url, class: "block" %>
            <% end %>
          </nav>
        </details>

        <details class="w-full group">
          <summary class="flex items-center justify-between space-x-4 py-2">
            <h3 class="font-bold"><%= link_to t("faqs.title"), "/faqs", class: "font-bold" %></h3>
          </summary>
        </details>
      </div>

      <%# "desktop menu footer" %>
      <div class="hidden md:grid w-3/4 grid-cols-4 gap-6">
        <div class="space-y-9">
          <div class="space-y-3">
            <h3 class="font-bold uppercase"><%= t("footer.product") %></h3>
            <nav class="space-y-3">
              <% data.links.product.each do |link| %>
                <%= link_to t(link.name, default: link.name), url(link.url), class: "block" %>
              <% end %>
            </nav>
          </div>

          <div class="space-y-3">
            <h3 class="font-bold uppercase"><%= t("footer.in_use") %></h3>
            <nav class="space-y-3">
              <% data.links.in_use.each do |link| %>
                <%= link_to t(link.name, default: link.name), url(link.url), class: "block" %>
              <% end %>
            </nav>
          </div>
        </div>

        <div class="space-y-9">
          <div class="space-y-3">
            <h3 class="font-bold uppercase"><%= t("footer.about") %></h3>
            <nav class="space-y-3">
              <% data.links.about.each do |link| %>
                <%= link_to t(link.name, default: link.name), url(link.url), class: "block" %>
              <% end %>
            </nav>
          </div>

          <h3 class="font-bold uppercase"><%= link_to t("footer.contact"), url(data.links.contact.first.url) %></h3>
        </div>

        <div class="space-y-9">
          <div class="space-y-3">
            <h3 class="font-bold uppercase"><%= t("footer.community") %></h3>
            <nav class="space-y-3">
              <% data.links.community.each do |link| %>
                <%= link_to t(link.name, default: link.name), url(link.url), class: "block" %>
              <% end %>
            </nav>
          </div>

          <div class="space-y-3">
            <h3 class="font-bold uppercase"><%= t("footer.news") %></h3>
            <nav class="space-y-3">
              <% data.links.news.each do |link| %>
                <%= link_to t(link.name, default: link.name), url(link.url), class: "block" %>
              <% end %>
            </nav>
          </div>
        </div>

        <div class="space-y-9">
          <div class="space-y-3">
            <h3 class="font-bold uppercase"><%= t("footer.legal") %></h3>
            <nav class="space-y-3">
              <% data.links.legal.each do |link| %>
                <%= link_to t(link.name, default: link.name), url(link.url), class: "block" %>
              <% end %>
            </nav>
          </div>

          <h3 class="font-bold uppercase"><%= link_to t("footer.faqs"), url(data.links.faqs.first.url) %></h3>
        </div>
      </div>
    </div>

    <nav class="flex md:hidden items-center justify-between mt-8">
      <% data_select_footer_social_media(data.links.social_media).each do |link| %>
        <% link_to link.url, target: "_blank", rel: "noopener noreferrer" do %>
          <%= icon link.icon, class: "w-4 h-4" %>
        <% end %>
      <% end %>
    </nav>

    <nav class="hidden md:flex justify-end space-x-3 md:pb-5 md:w-3/4">
      <% data_select_footer_social_media(data.links.social_media).each do |link| %>
        <% link_to link.url, target: "_blank", rel: "noopener noreferrer", title: link.name do %>
          <%= icon link.icon, class: "w-5 h-5" %>
        <% end %>
      <% end %>
    </nav>

    <div class="flex md:flex-row flex-col pt-6 md:border-t border-gray-500 md:w-3/4">
      <h3 class="flex items-center md:pb-0 pb-4 md:pr-5"><%= t("footer.supported_by") %></h3>
      <div class="flex items-center space-x-5">
        <% link_to "http://www.barcelona.cat", class: "w-24 h-5 flex items-center", target: "_blank", rel: "noopener noreferrer" do %>
          <%= image_tag "/images/logo_footer_barcelona.svg", resize: "150x50", alt: "Ajuntament de Barcelona" %>
        <% end %>
        <% link_to "http://www.localret.cat", class: "w-24 h-5 flex items-center", target: "_blank", rel: "noopener noreferrer" do %>
          <%= image_tag "/images/logo_footer_localret.png", resize: "150x50", alt: "Localret" %>
        <% end %>
        <% link_to "http://www.gencat.cat", class: "w-24 h-5 flex items-center", target: "_blank", rel: "noopener noreferrer" do %>
          <%= image_tag "/images/logo_footer_gencat.png", resize: "150x50", alt: "Generalitat de Catalunya" %>
        <% end %>
        <% link_to "https://www.diba.cat/", class: "w-24 h-5 flex items-center", target: "_blank", rel: "noopener noreferrer" do %>
          <%= image_tag "/images/logo_footer_diba.png", resize: "150x50", alt: "Diputació de Barcelona" %>
        <% end %>
      </div>
    </div>

    <div class="flex items-center justify-between pt-6 md:pt-6">
      <span class="text-white">&copy; <%= Date.today.strftime("%Y") %> - Creative Commons By-SA. <%= t("footer.trademark") %></span>
    </div>

  </div>
</footer>
