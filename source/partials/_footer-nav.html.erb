<div class="flex mt-6 md:mt-12">

      <%# "mobile menu footer" %>
      <div class="block md:hidden w-full divide-y divide-gray-500 cursor-pointer" data-accordion="footer">
        <details class="w-full group">
          <summary class="flex items-center justify-between space-x-4 py-2">
            <h3 class="font-bold"><%= t("footer.product") %></h3>
            <div class="flex-none w-5 h-5">
              <%= icon "ri-arrow-down-s-line", class: "w-5 h-5 group-open:hidden no-toggle" %>
              <%= icon "ri-arrow-up-s-line", class: "hidden group-open:block w-5 h-5 no-toggle" %>
            </div>
          </summary>
          <nav class="space-y-3 group-open:py-3 pointer-events-none -translate-y-full max-h-0 opacity-0 transition-all">
            <% data.links.product.each do |link| %>
              <%= link_to t(link.name, default: link.name), link.url, class: "block" %>
            <% end %>
          </nav>
        </details>

        <details class="w-full group">
          <summary class="flex items-center justify-between space-x-4 py-2">
            <h3 class="font-bold"><%= t("footer.in_use") %></h3>
